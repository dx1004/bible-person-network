{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Direct relationship discovery row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_relation_id",
    "subject_person_id",
    "object_person_id",
    "relation_type_hypotheses",
    "selected_relation_type",
    "selected_relation_direction",
    "passages",
    "path_contexts",
    "existing_edge_status",
    "existing_edge_ids",
    "status",
    "created_at",
    "source_snapshot"
  ],
  "properties": {
    "candidate_relation_id": {
      "type": "string",
      "pattern": "^drd-\\d{6}$"
    },
    "subject_person_id": {
      "type": "string",
      "anyOf": [
        { "pattern": "^nt-people-\\d{4}$" },
        { "pattern": "^person-\\d{6}$" }
      ]
    },
    "object_person_id": {
      "type": "string",
      "anyOf": [
        { "pattern": "^nt-people-\\d{4}$" },
        { "pattern": "^person-\\d{6}$" }
      ]
    },
    "relation_type_hypotheses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "kinship",
          "teacher_student",
          "collegial",
          "commission",
          "host",
          "political",
          "legal",
          "hostile",
          "succession",
          "alliance",
          "military",
          "prophetic_confrontation",
          "covenant",
          "friendship"
        ]
      }
    },
    "selected_relation_type": {
      "type": ["string", "null"],
      "enum": ["kinship", "teacher_student", "collegial", "commission", "host", "political", "legal", "hostile", "succession", "alliance", "military", "prophetic_confrontation", "covenant", "friendship", null]
    },
    "selected_relation_direction": {
      "type": ["string", "null"],
      "enum": ["directed", "undirected", null]
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "passage", "snippet", "excerpt_hash", "matched_relation_hints", "evidence_level", "source_snapshot"],
        "properties": {
          "source_id": {
            "type": "string",
            "const": "source:0003"
          },
          "passage": {
            "type": "string",
            "pattern": "^[1-3]?[A-Z]{2,4}\\s+\\d{1,3}:\\d{1,3}(?:-\\d{1,3})?$"
          },
          "snippet": {
            "type": "string",
            "minLength": 1
          },
          "excerpt_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_level": {
            "type": "string",
            "enum": ["ot_text", "nt_text"]
          },
          "matched_relation_hints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "kinship",
                "teacher_student",
                "collegial",
                "commission",
                "host",
                "political",
                "legal",
                "hostile",
                "succession",
                "alliance",
                "military",
                "prophetic_confrontation",
                "covenant",
                "friendship"
              ]
            }
          },
          "source_snapshot": {
            "type": "string",
            "const": "source:0003-cuv-usfm"
          }
        }
      }
    },
    "path_contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "path_length", "assertion_ids", "relation_type_chain", "via_assertions"],
        "properties": {
          "path": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "anyOf": [
                { "pattern": "^nt-people-\\d{4}$" },
                { "pattern": "^person-\\d{6}$" }
              ]
            }
          },
          "path_length": { "type": "number", "minimum": 2 },
          "assertion_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^asrt-\\d{4,6}$" }
          },
          "relation_type_chain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "kinship",
                "teacher_student",
                "collegial",
                "commission",
                "host",
                "political",
                "legal",
                "hostile",
                "succession",
                "alliance",
                "military",
                "prophetic_confrontation",
                "covenant",
                "friendship"
              ]
            }
          },
          "via_assertions": {
            "type": "object",
            "required": ["first", "second"],
            "additionalProperties": false,
            "properties": {
              "first": {
                "type": "object",
                "required": ["assertion_id", "relation_type", "direction", "traversal_direction"],
                "additionalProperties": false,
                "properties": {
                  "assertion_id": { "type": "string", "pattern": "^asrt-\\d{4,6}$" },
                  "relation_type": { "type": ["string", "null"] },
                  "direction": { "type": ["string", "null"] },
                  "traversal_direction": { "type": "string", "enum": ["forward", "reverse"] }
                }
              },
              "second": {
                "type": "object",
                "required": ["assertion_id", "relation_type", "direction", "traversal_direction"],
                "additionalProperties": false,
                "properties": {
                  "assertion_id": { "type": "string", "pattern": "^asrt-\\d{4,6}$" },
                  "relation_type": { "type": ["string", "null"] },
                  "direction": { "type": ["string", "null"] },
                  "traversal_direction": { "type": "string", "enum": ["forward", "reverse"] }
                }
              }
            }
          }
        }
      }
    },
    "existing_edge_status": {
      "type": "string",
      "enum": ["none", "active_existing", "inactive_only", "superseded_only", "mixed_inactive_states"]
    },
    "existing_edge_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^asrt-\\d{4,6}$" }
    },
    "status": { "type": "string", "const": "pending" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_created_at", "input_snapshot"],
      "properties": {
        "manifest_created_at": { "type": "string", "format": "date-time" },
        "input_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["people_snapshot_sha256", "names_snapshot_sha256", "mentions_snapshot_sha256", "assertions_snapshot_sha256", "source_id", "source_text_license", "scope", "files"],
          "properties": {
            "people_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "names_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "mentions_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "assertions_snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "source_id": { "type": "string", "const": "source:0003" },
            "source_text_license": { "type": "string" },
            "scope": { "type": "string" },
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["source_id", "source_path", "sha256", "bytes"],
                "additionalProperties": false,
                "properties": {
                  "source_id": { "type": "string", "const": "source:0003" },
                  "source_path": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "bytes": { "type": "number", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
