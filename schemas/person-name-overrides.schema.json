{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial canonical person-name override",
  "type": "object",
  "additionalProperties": false,
  "required": ["person_key", "unified_name", "rationale", "evidence_passages"],
  "properties": {
    "person_key": { "type": "string", "minLength": 1 },
    "unified_name": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence_passages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:MAT|MRK|LUK|JHN|ACT|ROM|1CO|2CO|GAL|EPH|PHP|COL|1TH|2TH|1TI|2TI|TIT|PHM|HEB|JAS|1PE|2PE|1JN|2JN|3JN|JUD|REV) [0-9]+:[0-9]+$" }
    }
  }
}
