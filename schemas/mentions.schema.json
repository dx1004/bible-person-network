{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mention",
  "type": "object",
  "additionalProperties": false,
  "required": ["mention_id", "person_id", "source_id", "passage", "location", "status", "created_at", "updated_at"],
  "properties": {
    "mention_id": { "type": "string", "pattern": "^mnt-\\d{4}$" },
    "person_id": {
      "type": "string",
      "anyOf": [
        { "pattern": "^nt-people-\\d{4}$" },
        { "pattern": "^person-\\d{6}$" }
      ]
    },
    "source_id": { "type": "string", "pattern": "^source:\\d{4}$" },
    "passage": { "type": "string", "pattern": "^[1-3]?[A-Z]{2,4}\\s+\\d{1,3}:\\d{1,3}(-\\d{1,3})?$" },
    "location": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["accepted", "pending", "excluded"] },
    "testament": { "type": "string", "enum": ["nt", "ot"] },
    "notes": { "type": "string" },
    "editorial_rationale": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
