{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pending historical-source person-hit coverage row",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "source_id", "matched_queries", "hit_count", "locators", "locators_capped", "status", "false_positive_risk_flags"],
  "properties": {
    "candidate_id": { "type": "string", "pattern": "^otc-\\d{4}$" },
    "source_id": { "type": "string", "enum": ["source:0006", "source:0007", "source:0010"] },
    "matched_queries": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true },
    "hit_count": { "type": "integer", "minimum": 0 },
    "locators": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path", "line", "matched_query"],
        "properties": {
        "source_path": { "type": "string", "pattern": "^\\.sources/(josephus-whiston-gutenberg|philo-yonge-1854-55|isbe-1915)/[^/]+\\.txt$" },
          "line": { "type": "integer", "minimum": 1 },
          "matched_query": { "type": "string", "minLength": 2 },
          "work": { "type": "string", "minLength": 1 },
          "book": { "type": "string", "pattern": "^[IVXLCDM]+$" },
          "chapter": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "locators_capped": { "type": "boolean" },
    "status": { "type": "string", "const": "pending" },
    "false_positive_risk_flags": {
      "type": "array",
      "items": { "type": "string", "enum": ["ambiguous_name_shared_by_candidates", "common_english_word_query", "front_matter_or_toc_hit", "ocr_requires_page_scan_confirmation", "short_query"] },
      "uniqueItems": true
    }
  }
}
