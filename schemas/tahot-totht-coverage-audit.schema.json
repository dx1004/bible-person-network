{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAHOT/TOTHT coverage audit rows",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "candidate_id",
    "step_identity_key",
    "canonical_name",
    "status",
    "strong_codes",
    "source_code_hits",
    "tahot_hit_count",
    "totht_hit_count",
    "sample_refs",
    "source_files_seen",
    "generated_at"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "pattern": "^ttca-otc-[0-9]{4}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^otc-[0-9]{4}$"
    },
    "step_identity_key": {
      "type": "string",
      "minLength": 1
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "candidate_decision": {
      "type": "string",
      "enum": ["pending", "accepted", "excluded"]
    },
    "status": {
      "type": "string",
      "enum": ["covered", "ambiguous", "unmatched"]
    },
    "strong_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[GH][0-9]{4}[A-Z]?$"
      }
    },
    "source_code_hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "tahot_hit_lines", "totht_hit_lines", "total_hit_lines"],
        "properties": {
          "code": { "type": "string", "pattern": "^[GH][0-9]{4}[A-Z]?$" },
          "tahot_hit_lines": { "type": "integer", "minimum": 0 },
          "totht_hit_lines": { "type": "integer", "minimum": 0 },
          "total_hit_lines": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "tahot_hit_count": { "type": "integer", "minimum": 0 },
    "totht_hit_count": { "type": "integer", "minimum": 0 },
    "matched_strength_codes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[GH][0-9]{4}[A-Z]?$" }
    },
    "ambiguous_strength_codes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[GH][0-9]{4}[A-Z]?$" }
    },
    "source_files_seen": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sample_refs": { "type": "array", "maxItems": 12, "items": { "type": "string", "pattern": "^[1-3]?[A-Z]{2,4} [0-9]+:[0-9]+$" } },
    "generated_at": { "type": "string", "format": "date-time" },
    "audit_note": { "type": "string" }
  }
}
