{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anchor Yale Bible Dictionary public person-headword audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "latinized", "candidate_ids", "locator_status", "matches", "audit_method", "reviewed_at"],
  "properties": {
    "source_id": {"const": "source:0009"},
    "latinized": {"type": "string", "minLength": 1},
    "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^otc-[0-9]{4}$"}},
    "locator_status": {"type": "string", "enum": ["direct_hit", "no_direct_hit"]},
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["article_title", "locator"],
        "properties": {
          "article_title": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "pattern": "^https://www\\.theologyandreligiononline\\.com/encyclopedia-chapter\\?docid=b-978030026(1875|1882|1899|1905|1912|1929)&tocid="}
        }
      }
    },
    "audit_method": {"const": "bloomsbury_official_person_list_exact_title"},
    "reviewed_at": {"type": "string", "format": "date-time"}
  }
}
