{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Old Testament person review rows",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "candidate_id",
    "step_identity_key",
    "candidate_status",
    "canonical_chinese",
    "review_method",
    "protocol_version",
    "review_roles",
    "round1",
    "round2",
    "final_decision",
    "source_id",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "review_id": { "type": "string", "pattern": "^otpr-\\d{4}$" },
    "candidate_id": { "type": "string", "pattern": "^otc-\\d{4}$" },
    "step_identity_key": { "type": "string", "minLength": 1 },
    "candidate_status": { "type": "string", "enum": ["pending", "accepted", "excluded"] },
    "canonical_chinese": { "type": ["string", "null"], "minLength": 1 },
  "review_method": { "type": "string", "enum": ["multi_agent_ai_review"] },
  "protocol_version": { "type": "string", "minLength": 1 },
    "review_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editorial", "critic", "boardroom"],
      "properties": {
        "editorial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role_id", "model_id", "prompt_version"],
          "properties": {
            "role_id": { "type": "string", "const": "editorial_a" },
            "model_id": { "type": "string", "minLength": 1 },
            "prompt_version": { "type": "string", "minLength": 1 }
          }
        },
        "critic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role_id", "model_id", "prompt_version"],
          "properties": {
            "role_id": { "type": "string", "const": "critic_b" },
            "model_id": { "type": "string", "minLength": 1 },
            "prompt_version": { "type": "string", "minLength": 1 }
          }
        },
        "boardroom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role_id", "model_id", "prompt_version"],
          "properties": {
            "role_id": { "type": "string", "const": "boardroom_adjudicator" },
            "model_id": { "type": "string", "minLength": 1 },
            "prompt_version": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "round1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision_action",
        "target_person_id",
        "canonical_chinese",
        "reviewer",
        "decision_note",
        "reviewed_at"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "decision_action": { "type": ["string", "null"], "enum": [null, "create_new", "merge_existing"] },
        "target_person_id": {
          "type": ["string", "null"],
          "anyOf": [
            { "pattern": "^nt-people-\\d{4}$" },
            { "pattern": "^person-\\d{6}$" }
          ]
        },
        "canonical_chinese": { "type": ["string", "null"], "minLength": 1 },
        "reviewer": { "type": ["string", "null"] },
        "decision_note": { "type": "string" },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "reviewer_role_id": { "type": ["string", "null"], "enum": ["editorial_a", "critic_b", "boardroom_adjudicator", null] },
        "reviewer_model_id": { "type": ["string", "null"], "minLength": 1 },
        "reviewer_prompt_version": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "round2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision_action",
        "target_person_id",
        "canonical_chinese",
        "reviewer",
        "decision_note",
        "reviewed_at"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "decision_action": { "type": ["string", "null"], "enum": [null, "create_new", "merge_existing"] },
        "target_person_id": {
          "type": ["string", "null"],
          "anyOf": [
            { "pattern": "^nt-people-\\d{4}$" },
            { "pattern": "^person-\\d{6}$" }
          ]
        },
        "canonical_chinese": { "type": ["string", "null"], "minLength": 1 },
        "reviewer": { "type": ["string", "null"] },
        "decision_note": { "type": "string" },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "reviewer_role_id": { "type": ["string", "null"], "enum": ["editorial_a", "critic_b", "boardroom_adjudicator", null] },
        "reviewer_model_id": { "type": ["string", "null"], "minLength": 1 },
        "reviewer_prompt_version": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "final_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision_action",
        "target_person_id",
        "canonical_chinese",
        "reviewer",
        "decision_note",
        "reviewed_at"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "decision_action": { "type": ["string", "null"], "enum": [null, "create_new", "merge_existing"] },
        "target_person_id": {
          "type": ["string", "null"],
          "anyOf": [
            { "pattern": "^nt-people-\\d{4}$" },
            { "pattern": "^person-\\d{6}$" }
          ]
        },
        "canonical_chinese": { "type": ["string", "null"], "minLength": 1 },
        "reviewer": { "type": ["string", "null"] },
        "decision_note": { "type": "string" },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "reviewer_role_id": { "type": ["string", "null"], "enum": ["editorial_a", "critic_b", "boardroom_adjudicator", null] },
        "reviewer_model_id": { "type": ["string", "null"], "minLength": 1 },
        "reviewer_prompt_version": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "source_id": { "type": "string", "enum": ["source:0002"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "evidence_audit": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["status", "reviewer_role_id", "reviewer_model_id", "prompt_version", "checked_at", "notes", "evidence_refs"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "passed", "failed"] },
        "reviewer_role_id": { "type": "string", "enum": ["evidence_auditor"] },
        "reviewer_model_id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "string", "minLength": 1 },
        "checked_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
