{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chinese name candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "person_id",
    "latinized",
    "candidate_chinese",
    "supporting_passages",
    "support_count",
    "mention_count",
    "coverage",
    "precision",
    "jaccard",
    "score",
    "score_margin_to_next",
    "ambiguity",
    "candidate_rank",
    "status",
    "source_id",
    "method"
  ],
  "properties": {
    "candidate_id": { "type": "string", "pattern": "^cnc-\\d{4}$" },
    "person_id": { "type": "string", "pattern": "^nt-people-\\d{4}$" },
    "latinized": { "type": "string", "minLength": 1 },
    "candidate_chinese": { "type": "string", "minLength": 1 },
    "supporting_passages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[1-3]?[A-Z]{2,4}\\s+\\d{1,3}:\\d{1,3}(-\\d{1,3})?$" }
    },
    "support_count": { "type": "number", "minimum": 0 },
    "mention_count": { "type": "number", "minimum": 0 },
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "precision": { "type": "number", "minimum": 0, "maximum": 1 },
    "jaccard": { "type": "number", "minimum": 0, "maximum": 1 },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "score_margin_to_next": { "type": "number", "minimum": -1, "maximum": 1 },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons", "notes"],
      "properties": {
        "level": { "type": "string", "enum": ["none", "shared_token", "multi_token", "shared_token_and_multi"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    },
    "status": { "type": "string", "enum": ["pending"] },
    "source_id": { "type": "string", "enum": ["source:0003"] },
    "method": { "type": "string", "minLength": 1 },
    "high_confidence_candidate": { "type": "boolean" },
    "candidate_rank": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
