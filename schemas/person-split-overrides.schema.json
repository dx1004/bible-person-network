{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial person split override",
  "type": "object",
  "additionalProperties": false,
  "required": ["split_id", "person_key", "rationale", "partitions"],
  "properties": {
    "split_id": { "type": "string", "pattern": "^split-person-\\d{4}$" },
    "person_key": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partition_id", "unified_name", "refs", "keep_relation_fields", "editor_note"],
        "properties": {
          "partition_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "unified_name": { "type": "string", "minLength": 1 },
          "unified_raw": { "type": "string", "minLength": 1 },
          "refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[1-3]?[A-Z]{2,3} \\d+:\\d+$" }
          },
          "keep_relation_fields": { "type": "boolean" },
          "editor_note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
