{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated CUV Chinese-name candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["person_id", "candidate_chinese", "source_passage", "canonical_passage", "editor_note"],
  "properties": {
    "person_id": { "type": "string", "pattern": "^nt-people-\\d{4}$" },
    "candidate_chinese": { "type": "string", "minLength": 1 },
    "source_passage": { "type": "string", "pattern": "^[1-3]?[A-Z]{2,4} \\d{1,3}:\\d{1,3}$" },
    "canonical_passage": { "type": "string", "pattern": "^[1-3]?[A-Z]{2,4} \\d{1,3}:\\d{1,3}$" },
    "source_tokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "editor_note": { "type": "string", "minLength": 1 }
  }
}
