{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Old Testament relationship candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_relation_id", "subject_person_id", "object_person_id",
    "relation_type", "relation_subtype", "direction", "evidence",
    "source_candidate_ids", "source_tokens", "status", "created_at"
  ],
  "properties": {
    "candidate_relation_id": { "type": "string", "pattern": "^otrelc-\\d{6}$" },
    "subject_person_id": { "type": "string", "pattern": "^person-\\d{6}$" },
    "object_person_id": { "type": "string", "pattern": "^person-\\d{6}$" },
    "relation_type": { "const": "kinship" },
    "relation_subtype": { "type": "string", "enum": ["parent", "sibling", "partner"] },
    "direction": { "type": "string", "enum": ["directed", "undirected"] },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "passage", "evidence_level", "note", "certainty"],
        "properties": {
          "source_id": { "const": "source:0002" },
          "passage": { "type": "string", "pattern": "^[1-3]?[A-Z]{2,4}\\s+\\d{1,3}:\\d{1,3}$" },
          "evidence_level": { "const": "modern_reference" },
          "note": { "type": "string", "minLength": 1 },
          "certainty": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "source_candidate_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^otc-\\d{4}$" } },
    "source_tokens": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "const": "pending" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
