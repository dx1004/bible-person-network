{
  "name": "new-testament-person-network-data",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned people and relationship corpus for New Testament person network (data pipeline only).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fetch:sources": "node scripts/fetch-sources.mjs",
    "fetch:historical-sources": "node scripts/fetch-historical-sources.mjs",
    "ingest": "node scripts/build-stepbible-corpus.js",
    "ingest:locked": "node scripts/build-stepbible-corpus.js --step-data-dir .sources/stepbible-data --sblgnt-dir .sources/sblgnt",
    "validate:data": "node scripts/validate-and-build.js",
    "init:chinese-name-review": "node scripts/init-chinese-name-review.js",
    "validate:chinese-name-review": "node scripts/init-chinese-name-review.js --validate-only",
    "apply:chinese-name-review": "node scripts/apply-chinese-name-review.js",
    "init:relationship-review": "node scripts/init-relationship-review.js",
    "apply:relationship-review": "node scripts/apply-relationship-review.js",
    "validate:relationship-review": "node scripts/init-relationship-review.js --validate-only",
    "merge:independent-reviews": "node scripts/merge-independent-reviews.js",
    "merge:v2-independent-reviews": "node scripts/merge-v2-independent-reviews.js",
    "merge:history-independent-reviews": "node scripts/merge-history-independent-reviews.js",
    "merge:sbl-greek-audit": "node scripts/merge-sbl-greek-audit.js",
    "validate:sbl-greek-audit": "node scripts/merge-sbl-greek-audit.js --validate-only",
    "generate:chinese-name-candidates": "node scripts/generate-chinese-name-candidates.js",
    "validate:chinese-name-candidates": "node scripts/generate-chinese-name-candidates.js --validate-only",
    "reconcile": "node scripts/reconcile-sources.js",
    "report": "node scripts/report.js",
    "test:step-boundary": "node scripts/test-step-boundary-regression.mjs",
    "build:web": "npm --prefix web run build",
    "typecheck:web": "npm --prefix web run typecheck",
    "release:check": "npm run check",
    "precheck": "npm run validate:source-access-review",
    "pages:preview": "npm run release:check && wrangler pages deploy web/dist --project-name new-testament-person-network --branch preview",
    "pages:production": "npm run release:check && wrangler pages deploy web/dist --project-name new-testament-person-network --branch main",
    "check": "npm run validate:sbl-greek-audit && npm run validate:data && npm run check:migration && npm run validate:old-testament-candidates && npm run validate:historical-source-person-hits && npm run validate:old-testament-chinese-name-candidates && npm run validate:old-testament-person-review && npm run validate:old-testament-person-review-sidecar && npm run test:old-testament-person-review-sidecar && npm run validate:cross-testament-identity-review && npm run validate:tahot-totht-coverage-audit && npm run validate:chinese-name-candidates && npm run validate:chinese-name-review && npm run apply:chinese-name-review -- --check && npm run validate:relationship-review && npm run apply:relationship-review -- --check && npm run reconcile && npm run report && npm run test:step-boundary && npm run typecheck:web && npm --prefix web run check-person-era && npm run build:web && npm --prefix web run check-identity",
    "generate:old-testament-candidates": "node scripts/generate-old-testament-candidates.mjs",
    "validate:old-testament-candidates": "node scripts/generate-old-testament-candidates.mjs --validate-only",
    "init:old-testament-person-review": "node scripts/init-old-testament-person-review.js",
    "validate:old-testament-person-review": "node scripts/init-old-testament-person-review.js --validate-only",
    "generate:historical-source-person-hits": "node scripts/generate-historical-source-person-hits.mjs",
    "validate:historical-source-person-hits": "node scripts/generate-historical-source-person-hits.mjs --validate-only",
    "generate:cross-testament-identity-review": "node scripts/generate-cross-testament-identity-review.mjs",
    "validate:cross-testament-identity-review": "node scripts/generate-cross-testament-identity-review.mjs --validate-only",
    "check:migration": "node scripts/migrate-neutral-person-ids.mjs --check",
    "generate:tahot-totht-coverage-audit": "node scripts/audit-tahot-totht-coverage.mjs",
    "validate:tahot-totht-coverage-audit": "node scripts/audit-tahot-totht-coverage.mjs --validate-only",
    "validate:source-access-review": "node scripts/validate-source-access-review.mjs",
    "verify:historical-sources": "node scripts/validate-source-access-review.mjs --verify-local",
    "apply:old-testament-person-review-sidecar": "node scripts/apply-old-testament-person-review-sidecar.js",
    "validate:old-testament-person-review-sidecar": "node scripts/validate-old-testament-person-review-sidecar.js",
    "test:old-testament-person-review-sidecar": "node scripts/test-old-testament-person-review-sidecar.js",
    "generate:old-testament-chinese-name-candidates": "node scripts/generate-old-testament-chinese-name-candidates.mjs",
    "validate:old-testament-chinese-name-candidates": "node scripts/generate-old-testament-chinese-name-candidates.mjs --validate-only"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "wrangler": "^4.126.0"
  }
}
